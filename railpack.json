{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "steps": {
    "install": {
      "inputs": [
        { "step": "packages:mise" },
        { "local": true, "include": ["."] }
      ],
      "commands": [
        "python -m venv .venv",
        ".venv/bin/python -m pip install --no-cache-dir -r requirements.txt"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }]
    }
  },
  "deploy": {
    "startCommand": ".venv/bin/python -m uvicorn python.main:app --host 0.0.0.0 --port $PORT"
  }
}
